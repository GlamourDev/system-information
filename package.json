{
  "name": "system-information",
  "productName": "System Information",
  "version": "1.1.0",
  "license": "MIT",
  "author": {
    "name": "Henry Lõiv"
  },
  "private": true,
  "description": "Hardware information and live sensor monitoring.",
  "main": "dist/app-entry.js",
  "scripts": {
    "start": "electron .",
    "check": "tsc --noEmit",
    "test": "node --test",
    "build:css": "sass --no-source-map --style=compressed src/web/styles/core.scss dist/css/core.css",
    "watch:css": "sass --watch --no-source-map --style=compressed src/web/styles/core.scss:dist/css/core.css",
    "prestart": "npm run build",
    "build:js": "node scripts/build.mjs",
    "build": "npm run check && npm run build:js && npm run build:css",
    "pretest": "npm run build && node scripts/build-tests.mjs",
    "smoke:hardware": "node scripts/check-hardware.mjs",
    "package:dir": "npm run build && npm run build:windows-helper && npm run build:smartmontools && install-electron && electron-builder --dir",
    "package:release": "npm run build && npm run build:windows-helper && npm run build:smartmontools && install-electron && electron-builder --publish never",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "npm run lint -- --fix",
    "rebuild:native": "electron-builder install-app-deps",
    "build:windows-helper": "node scripts/build-windows-helper.mjs",
    "build:smartmontools": "node scripts/build-smartmontools.mjs"
  },
  "dependencies": {
    "systeminformation": "5.33.16"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "oxlint": "1.89.0",
    "sass": "1.106.1",
    "typescript": "7.0.2"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "build": {
    "appId": "SystemInformation.App",
    "productName": "System Information",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 ${author}",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "assets/icons"
    },
    "files": [
      "dist/**/*",
      "assets/icons/*",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "icon": "assets/icons/app.icns",
      "category": "public.app-category.utilities",
      "identity": "-",
      "target": [
        "zip"
      ],
      "notarize": false,
      "extraResources": [
        {
          "from": "native/smartmontools/publish/darwin-${arch}",
          "to": "smartmontools",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icons/app.ico",
      "target": [
        "zip"
      ],
      "extraResources": [
        {
          "from": "native/windows/publish/${arch}",
          "to": "sensors",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "native/smartmontools/publish/win32-${arch}",
          "to": "smartmontools",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icons/app.png",
      "category": "System",
      "target": [
        "tar.gz"
      ]
    },
    "extraResources": [
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ],
    "asarUnpack": [
      "node_modules/**/*.node"
    ]
  },
  "optionalDependencies": {
    "macos-temperature-sensor": "2.1.1",
    "osx-temperature-sensor": "1.0.8"
  },
  "allowScripts": {
    "macos-temperature-sensor@2.1.1": true,
    "osx-temperature-sensor@1.0.8": true
  }
}
